[account]
# Your payout wallet. Must start with 0x. Leave empty and the miner will ask on first run.
address =
# Name shown on the dashboard and woodyminer. Leave empty for an auto-generated name.
worker =

[server]
# Pool website. Do not add /difficulty or /verify — the miner adds those.
base_url = http://xenblocks.io
# How long one /verify POST may wait (seconds).
connection_timeout_s = 3
# SOCKS/HTTP proxy for POST /verify only. Empty = box IP.
# vast.sh fills this when verify_warp_socks is true.
verify_proxy =
# Same-IP fleets (Vast, one host NAT): POST /verify through a local WARP SOCKS.
# Not a VPN — SSH, GPU, Woodyminer stay on this machine. Default on.
# false = submit from this box IP. Save this file — the miner bags the queue and
# restarts itself (same path as GitHub auto-update). Do not reboot the machine.
verify_warp_socks = true
# Live /difficulty poll (seconds). This is the only clock for /verify match.
network_poll_interval_s = 1
network_poll_timeout_s = 3
network_down_poll_interval_s = 1
send_pow_url = http://xenblocks.io:4446/send_pow
# Credit is POST /verify only.
send_pow_enabled = false
send_pow_split = false

[mining]
# How new keys/nonces are picked. Leave as random.
strategy = random
# Fallback memory cost (m=) if you are not force-mining below. Protocol default is 1100.
# Leave this alone unless you turn force_mine_memory_cost off.
memory_cost = 1100
# Argon2 time cost. Network rule — leave at 1.
time_cost = 1
# Argon2 parallelism. Network rule — leave at 1.
parallelism = 1
# Hash length in bytes. Network rule — leave at 64.
hash_len = 64
# Always mine at this memory cost on the GPU.
# 100 = fastest hashrate. Finds sit in the queue until live m= matches, then /verify.
# 0 = follow whatever the network is doing (slower when the network is hard).
force_mine_memory_cost = 100
# Credit is POST /verify (not send_pow). false = bag-only, desktop submits.
submit_enabled = true
# CPU-flush when live /difficulty matches bag m=.
match_drain_enabled = true
# Start submitting once at least this many queued blocks match the current network.
match_drain_min_queue = 1
# Max seconds for one submit burst. 0 = keep flushing until the bag is empty or live diff leaves.
match_drain_max_s = 0
# In-flight /verify workers during match-flush. 512 matched the live dummy peak.
match_drain_parallel = 512
# Hashes per wave. With flush-every 1s this is ~512 /verify POSTs per second.
match_drain_batch = 512
# XUNI hunting is OFF. Existing queued XUNI still flush :55–:04. GPU stays on XNM/XBLK.
xuni_mining_enabled = false
# Stop looking for new XUNI when this many XUNI are already waiting in the queue.
xuni_queue_soft_cap = 100
# Start looking for XUNI again after the queue falls to this number (must be below the cap above).
xuni_queue_resume = 40
# Only 1 in every N batches tries for XUNI. Lower = more XUNI attempts, a bit more CPU work.
xuni_every_n_batches = 3
# How many GPU lanes may hunt XUNI. The rest stay on normal XEN11 (XNM / XBLK).
xuni_max_lanes = 2

[efficiency]
# How much of the card's VRAM to use, as a percent. Lane count and batch size
# are then sized from this card's total VRAM (~3.5 GiB per lane at m=100).
# 80% is about 25 GB used on a 32 GB card; an 8 GB card still gets 2 lanes.
target_vram_pct = 80.0
# Percent of VRAM to leave free for the driver and other apps.
desktop_headroom_pct = 20.0
# Emergency stop if used VRAM goes above this percent.
emergency_vram_pct = 95.0
# Never leave less than this percent of VRAM free.
min_headroom_pct = 3.5
# Extra VRAM reserved for the GPU driver itself, as a percent of the card.
runtime_overhead_pct = 6.0
# Absolute minimum free VRAM in MiB, if the percent above would be too small.
min_headroom_floor_mib = 512
# Absolute minimum driver reserve in MiB.
runtime_overhead_floor_mib = 256
# Optional fixed MiB numbers. 0 = use the percents above (recommended).
target_vram_mib = 0
headroom_mib = 0
emergency_vram_mib = 0
min_headroom_mib = 0
# Pause mining if the GPU chip itself reaches this temperature (°C).
max_gpu_temp_c = 85
# Warning temperature for the GPU chip (°C). Memory junction below is the main control.
warn_gpu_temp_c = 75
# Hard ceiling for memory-junction temperature (°C). Above this the miner cuts work.
max_mem_temp_c = 85
# Hold point for memory-junction temperature (°C).
warn_mem_temp_c = 81
# true = use memory junction as the heat control. false = die only.
thermal_use_memory_junction = true
# Seconds to pause only if memory is still over the hard cap at the smallest allowed batch.
gpu_cooldown_s = 20
# Miner does not set the card's power limit. Leave nvidia-smi / the host panel in charge
# (Vast template clocks, Afterburner on Windows). true can fight those and cut H/s.
gpu_power_boost_enabled = false
gpu_power_target_pct = 100
gpu_power_min_pct = 100
# Do not drop power just because the network is hard.
gpu_difficulty_power_enabled = false
gpu_difficulty_power_full_ratio = 2.0
gpu_thermal_batch_enabled = true
# Start at 70% of the VRAM pack, then climb +1 job toward the hold point.
gpu_thermal_start_scale = 0.70
thermal_batch_step = 1
thermal_settle_s = 15
# Smallest batch the heat control will allow. 0.70 keeps a 16 GB card from collapsing to 30%.
gpu_thermal_batch_min_scale = 0.70
# Switch Windows to the High Performance power plan while mining.
gpu_windows_performance_mode = true
# How often (seconds) to read temperature, power, and VRAM.
sample_interval_s = 5

[queue]
# Database of found blocks that have not been accepted yet (folder is relative to this miner).
db_path = data/blocks.db
# Text list of found blocks waiting to submit.
jsonl_path = data/queue.jsonl
# Log of blocks the pool rejected.
rejected_jsonl_path = data/rejected.jsonl
# Old setting. Submits already run on their own CPU thread — leave at 0.30.
submit_cpu_fraction = 0.30
# m=100 parks CUDA. First 6 physical cores flush; last 2 stay CUDA host for resume.
desktop_cpu_cores = 0
bag_sort_cpu_cores = 0
flush_cpu_cores = 6
dashboard_cpu_cores = 0
# Copy every queued hit to the Windows home vault. Local bag stays and still flushes.
# Example: http://YOUR.HOME.IP:18787/bag
bag_forward_url =
bag_forward_token =
bag_forward_batch = 32

[monitoring]
# Main text log.
log_path = data/session.log
# Periodic snapshot of hashrate, temp, and stats (one line every sample).
timelapse_path = data/session_timelapse.jsonl
# How often (seconds) the on-screen dashboard refreshes.
stats_interval_s = 4
# How often (seconds) to write a timelapse snapshot.
timelapse_sample_s = 30
# Live dashboard in the console. false = log text only.
dashboard_enabled = true
# Upload stats to the woodyminer.com leaderboard.
woodyminer_enabled = true
# Woodyminer address. Leave the default unless you host your own.
woodyminer_upload_url = https://woodyminer.com/api/stat/upload
# Seconds between woodyminer uploads.
woodyminer_upload_period_s = 60
# Name shown on woodyminer. If empty, the worker name above is used.
woodyminer_custom_name =
# Send events to a local XenBlockScan tracker. Leave false unless you run one.
xenblockscan_enabled = false
xenblockscan_endpoint = http://127.0.0.1:8787/api/v1/events
xenblockscan_api_key =
xenblockscan_report_rejects = false
xenblockscan_holdings_interval_s = 30
xenblockscan_backfill = false
# Your unique tracker id. Leave as-is unless you know you need a new one.
tracker_id =

[update]
# Pull a newer GitHub commit, bag the queue, rebuild, restart. Uses GH_TOKEN from the environment.
enabled = true
github_repo = badnob/xnminer-low-dif-hybrid-blackwell
github_ref = main
check_interval_s = 300
token =
sha_path = data/build_sha

[cuda]
# All 0 values below mean "measure this GPU / CPU at start". That is the
# new-user default. Only set a number if you want to override auto-detect.
#
# 12 = desktop (6 physical cores × SMT), pinned OFF the CUDA-host spin cores.
# An 8-core Vast box matches the desktop 16-core miner slice. Do not clamp this
# to CUDA host count — that is what left Vast at ~60% GPU util.
keygen_threads = 12
# Which NVIDIA card to use. 0 = the first card.
device_id = 0
# Fixed hashes per lane. 0 = pick the size automatically from this card's VRAM (recommended).
batch_size = 0
# Extra cap on hashes per lane.
# 0 = no cap, fill the VRAM target (32 GB @ 80% ≈ 8 x 28769; 16 GB ≈ 4 lanes; 8 GB ≈ 2 lanes).
max_batch_size = 0
# How many GPU lanes run at once. 0 = auto from this card's total VRAM
# (8 GB→2, 12→3, 16→4, 24→6, 32→8). Setting 8 on an 8 GB card is clamped down.
max_lanes = 0
# Keep this many lanes in reserve. Leave at 1 unless you know you want every lane.
lane_reserve = 1
# Extra GPU-driver memory in MiB. 0 = use the percent under [efficiency] instead.
runtime_overhead_mib = 0
# How many NEXT-key bags to stage while the GPU hashes the full pack.
# 2 = current keys + one preloaded bag. Does NOT split the live batch. 3 = later.
work_patches = 2
